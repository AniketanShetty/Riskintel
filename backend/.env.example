# RiskIntel - Backend Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# FastAPI / Uvicorn
HOST=0.0.0.0
PORT=8000
WORKERS=4
DEBUG=false
LOG_LEVEL=INFO

# SQLite (canonical V1 backend — single authoritative persistence)
DB_PATH=riskintel.db

# Security
SECRET_KEY=change-me-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Paths (relative to project root)
MODEL_DIR=../models
